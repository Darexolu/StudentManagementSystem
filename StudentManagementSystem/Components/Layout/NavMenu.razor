@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
	private bool isAcademicMenuOpen = false;
	private bool isTimetableOpen = false;
	private bool isExamOpen = false;
	private bool isAttendanceOpen = false;


	private void ToggleAcademicMenu()
	{
		isAcademicMenuOpen = !isAcademicMenuOpen;
	}
	private void ToggleTimetable()
	{
		isTimetableOpen = !isTimetableOpen;
	}
	

	private void ToggleExam()
	{
		isExamOpen = !isExamOpen;
	}

	private void ToggleAttendance()
	{
		isAttendanceOpen = !isAttendanceOpen;
	}
}

