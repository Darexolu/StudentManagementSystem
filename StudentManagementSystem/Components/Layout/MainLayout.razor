@using StudentManagementSystem.Client.Services
@using StudentManagementSystemShared.Models
@using StudentManagementSystemShared.StudentRepository
@inherits LayoutComponentBase
@inject ISystemSettingsRepository SettingsRepository
@inject AppSettingsService AppSettings
<div class="app-layout">

    <NavMenu />

    <div class="page-area">

		<header class="topbar">
			<div class="school-header">
				<h3 >
					@(string.IsNullOrWhiteSpace(settings?.SchoolName)
												? "School Management System"
												: settings.SchoolName)
				</h3>

				@if (!string.IsNullOrWhiteSpace(settings?.SchoolMotto))
				{
					<small class="text-muted mt-0">
						@settings.SchoolMotto
					</small>
				}
			</div>

			<div class="topbar-right">
				<AuthorizeView>
					<Authorized>
						<form action="/Account/Logout" method="post">
							<AntiforgeryToken />

							<input type="hidden" name="returnUrl" value="Account/Login" />

							<button type="submit" class="logout-btn">
								<i class="nav-icon fas fa-sign-out-alt"></i>
								Logout
							</button>
						</form>
					</Authorized>
				</AuthorizeView>
			</div>
		</header>

        <main class="main-content">
            @Body
        </main>

    </div>
	@* <footer class="main-footer">
		<strong>Copyright &copy; @DateTime.Now.Year <a href="">Designed and developed by Darex Olu</a>.</strong>
		All rights reserved.
		<div class="float-right d-none d-sm-inline-block">
			<b>Version</b> 3.2.0
		</div>
	</footer> *@
</div>
@code {
	private SystemSetting settings;

	protected override async Task OnInitializedAsync()
	{
		settings = await AppSettings.GetAsync();
	}
}

   