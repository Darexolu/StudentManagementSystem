@page "/students-list"
@using StudentManagementSystemShared.Models;
@inject NavigationManager navigation;
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Super Admin")]
@inject IJSRuntime JsRuntime


@* <h3> Students List</h3>
@rendermode InteractiveAuto *@

    <div class="row">
     <div class="col-12">
          <div class="card">
           <div class="card-header">
				<div class="page-actions">
					<a class="btn-add" href="/add-student">
						<i class="fas fa-plus"></i>  <span>Add New Student</span>
					</a>
				</div>
				
               </div>
               <div class="card-body">

    <div class="row">
					<h3 class="page-title">
						<i class="fas fa-user-graduate"></i>
						Students List
					</h3>
        <div class="col-md-12">
            <div class="card">
                <div class="card-header"></div>
                @* @if (!AllStudents.Any())
                {
                   <p><em>Loading Students...</em></p> 
                } *@
                @if (AllStudents.Any())
                {
                   <div class="card-body">
					   <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
                           <thead>
                               <tr>
													<!-- Mobile -->
													<th class="d-table-cell d-md-none">Student</th>

													<!-- Desktop -->
													<th class="d-none d-md-table-cell">Full Name</th>
													<th class="d-none d-md-table-cell">Admission No.</th>
													<th class="d-none d-md-table-cell">Email</th>
													<th class="d-none d-md-table-cell">Gender</th>

													<th>Edit</th>
													<th>Delete</th>
                               </tr>
                           </thead>
                           <tbody>
                            @foreach(var student in AllStudents)
                            {<tr>

														<!-- Mobile -->
														<td class="d-table-cell d-md-none">
															<div class="student-mobile">
																<div class="student-name">@student.FullName</div>
																<div class="student-admission">@student.AdmissionNumber</div>
															</div>
														</td>

														<!-- Desktop -->
														<td class="d-none d-md-table-cell">@student.FullName</td>
														<td class="d-none d-md-table-cell">@student.AdmissionNumber</td>
														<td class="d-none d-md-table-cell">@student.EmailAddress</td>
														<td class="d-none d-md-table-cell">
															@student.Gender?.ToString().Replace("NonBinary", "Non-binary")
														</td>

														<td>
															<a class="btn-table btn-edit" href="/student/edit/@student.Id">
																<i class="fas fa-edit"></i>
																<span>Edit</span>
															</a>
														</td>

														<td>
															<a class="btn-table btn-delete" href="/student/delete/@student.Id">
																<i class="fas fa-trash"></i>
																<span>Delete</span>
															</a>
														</td>
                            </tr>
                            }
                        </tbody>
                       </table>
					</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info"> There is no Students List Available</div>
                }
            </div>

        </div>
    </div>
  </div>
    </div>
</div>
</div>


@code {
    private List<Student> AllStudents { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadAllStudents();
    }
    private async Task LoadAllStudents()
    {
        var students = await StudentService.GetAllStudentsAsync();
        AllStudents.Clear();
        if (students is null) return;
        foreach(var student in students)
        {
            AllStudents.Add(student);
        }
    }
    private void EditStudent(Guid id)
    {
        navigation.NavigateTo($"/student/edit/{id}");
    }
    private async Task DeleteStudent(Guid Id)
    {
        var result = await StudentService.DeleteStudentAsync(Id);
        await LoadAllStudents();
    }

}

     