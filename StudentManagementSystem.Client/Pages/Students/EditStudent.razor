@page "/student/edit/{id:guid}"
@using StudentManagementSystemShared.Models;
@using Microsoft.AspNetCore.Authorization;
@using StudentManagementSystem.Utility;
@attribute [Authorize(Roles = "Admin,Super Admin")]
@inject NavigationManager navigation;
@rendermode InteractiveServer
@inject ISchoolClassRepository ClassRepository

<div class="student-form-header">
	<h2 class="student-form-title">
		<i class="fas fa-user-edit"></i>
		Update Student
	</h2>

	<p class="student-form-subtitle">
		Update student's details below.
	</p>
</div>


			<div class="student-form-wrapper">
				<div class="student-form-card">
                        <EditForm Model="studobj" OnValidSubmit="UpdateStudent" FormName="updatestudent">
                           @*  <DataAnnotationsValidator />
                            <ValidationSummary /> *@
							<div class="student-form-grid">

								<!-- First Name -->
								<div class="form-group">
									<label class="control-label">First Name</label>
									<InputText required class="form-control"
											   @bind-Value="studobj.FirstName" />
									<ValidationMessage For="()=>studobj.FirstName" />
								</div>

								<!-- Middle Name -->
								<div class="form-group">
									<label class="control-label">Middle Name</label>
									<InputText required class="form-control"
											   @bind-Value="studobj.MiddleName" />
									<ValidationMessage For="()=>studobj.MiddleName" />
								</div>

								<!-- Last Name -->
								<div class="form-group">
									<label class="control-label">Last Name</label>
									<InputText required class="form-control"
											   @bind-Value="studobj.LastName" />
									<ValidationMessage For="()=>studobj.LastName" />
								</div>

								<!-- Admission Number -->
								<div class="form-group">
									<label class="control-label">Admission Number</label>
									<InputText required class="form-control required"
											   @bind-Value="studobj.AdmissionNumber" />
									<ValidationMessage For="()=>studobj.AdmissionNumber" />
								</div>

								<!-- Email -->
								<div class="form-group">
									<label class="control-label">Email Address</label>
									<InputText class="form-control"
											   @bind-Value="studobj.EmailAddress" />
									<ValidationMessage For="()=>studobj.EmailAddress" />
								</div>

								<!-- Phone -->
								<div class="form-group">
									<label class="control-label">Phone Number</label>
									<InputText class="form-control"
											   @bind-Value="studobj.PhoneNumber" />
									<ValidationMessage For="()=>studobj.PhoneNumber" />
								</div>

								<!-- Address -->
								<div class="form-group student">
									<label class="control-label">Student Address</label>
					<InputTextArea class="form-control" style="resize: none;"
											   @bind-Value="studobj.Address" />
									<ValidationMessage For="()=>studobj.Address" />
								</div>
								<!-- DOB -->
								<div class="form-group">
									<label class="control-label">Date of Birth</label>
									<InputDate class="form-control"
											   @bind-Value="studobj.DOB" />
								</div>
								<!-- Gender -->
								<div class="sms-select-group">
									<div class="form-group">
										<label class="control-label">Gender</label>
										<InputSelect required class="form-select"
													 @bind-Value="studobj.Gender">
											<option value="">Select Gender</option>
											@foreach (var g in Enum.GetValues(typeof(Gender)).Cast<Gender>())
											{
												<option value="@g">@g</option>
											}
										</InputSelect>
									</div>
								</div>

								<div class="sms-select-group">
									<div class="form-group">
										<label class="control-label">Class</label>
										<InputSelect required class="form-select"
													 @bind-Value="studobj.SchoolClassId">

											<option value="">Select Class</option>

											@foreach (var c in Classes)
											{
												<option value="@c.Id">@c.Name</option>
											}

										</InputSelect>
									</div>
								</div>
							</div>
							<div class="student-form-actions">
								<button type="submit" class="student-btn-save">
									<i class="fas fa-save"></i>
									Update Student
								</button>

								<a href="/students-list" class="student-btn-back">
									<i class="fas fa-arrow-left"></i>
									Back to List
								</a>
							</div>
                        </EditForm>
                    </div>
                </div>
           
        
   


@code {

    [SupplyParameterFromForm]
    public Student studobj { get; set; } = new Student();

	List<SchoolClass> Classes = new();

    [Parameter]
    public Guid id { get; set; }


    protected override async Task OnInitializedAsync()
	{
		Classes = await ClassRepository.GetAllAsync();

            await LoadStudent();
        
    }
    public async Task LoadStudent()
    {
		if (id != Guid.Empty && studobj.FirstName == null)
		{
			studobj = await StudentService.GetStudentByIdAsync(id);
		}
		else
		{
			studobj.Id = id;
		}            
    }


    protected async Task UpdateStudent()
    {
        var result = await StudentService.UpdateStudentAsync(studobj);
        navigation.NavigateTo("/students-list");
    }
    public void Cancel()
    {
        navigation.NavigateTo("/students-list");
    }
}