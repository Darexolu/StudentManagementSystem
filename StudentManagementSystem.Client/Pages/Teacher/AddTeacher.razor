@page "/add-teacher"﻿
@using StudentManagementSystem.Client.Services
@using StudentManagementSystemShared.Models;
@using Microsoft.AspNetCore.Authorization;
@using StudentManagementSystem.Utility;
@attribute [Authorize(Roles = "Admin,Super Admin")]
@inject NavigationManager navigation;

<div class="student-form-header">

<h2 class="student-form-title"><i class="fas fa-user-plus"></i> <span>Add New Teacher</span></h2>
 <p class="student-form-subtitle">
        Enter the teacher's details below.
    </p>
</div>

@* <hr /> *@
<div class="student-form-wrapper">
    <div class="student-form-card">
 <EditForm Model="teacherobj" OnValidSubmit="CreateTeacher" FormName="addteacher">
          
             <div class="student-form-grid">
                        <div class="form-group">
                            <label class="control-label">First Name</label>
                            <InputText for="FirstName" required class="form-control" @bind-Value="@teacherobj.FirstName"/>
                            <ValidationMessage For="()=>teacherobj.FirstName"/>
                        </div>
                    
                     
                        <div class="form-group">
                            <label class="control-label">Middle Name</label>
                            <InputText required for="MiddleName" class="form-control" @bind-Value="@teacherobj.MiddleName" />
                            <ValidationMessage For="()=>teacherobj.MiddleName" />
                        </div>
                   
                    
                        <div class="form-group">
                            <label class="control-label">Last Name</label>
                            <InputText for="LastName" required class="form-control" @bind-Value="@teacherobj.LastName" />
                            <ValidationMessage For="()=>teacherobj.LastName" />
                        </div>
                    
					 
                        <div class="form-group">
                            <label class="control-label">Email Address</label>
                            <InputText for="EmailAddress" class="form-control" @bind-Value="@teacherobj.EmailAddress" />
                            <ValidationMessage For="()=>teacherobj.EmailAddress" />
                        </div>
                    
                        <div class="form-group">
                            <label class="control-label">Address</label>
                            <InputTextArea for="Address" class="form-control" style="resize: none;" @bind-Value="@teacherobj.Address" />
                            <ValidationMessage For="()=>teacherobj.Address" />
                        </div>
                   
                    
                        <div class="form-group">
                            <label class="control-label">Phone Number</label>
                            <InputText required for="PhoneNumber" class="form-control" @bind-Value="@teacherobj.PhoneNumber" />
                            <ValidationMessage For="()=>teacherobj.PhoneNumber" />
                        </div>
                   
                   
                        <div class="form-group">
                            <label class="control-label">Facebook Link</label>
                            <InputText for="FacebookLink" class="form-control" @bind-Value="@teacherobj.FacebookLink" />
                            <ValidationMessage For="()=>teacherobj.FacebookLink" />
                        </div>
                   
                    
                        <div class="form-group">
                            <label class="control-label">Twitter Link</label>
                            <InputText for="TwitterLink" class="form-control" @bind-Value="@teacherobj.TwitterLink" />
                            <ValidationMessage For="()=>teacherobj.TwitterLink" />
                        </div>
                   
                    
                        <div class="form-group">
                            <label class="control-label">LinkedIn Link</label>
                            <InputText for="LinkedInLink" class="form-control" @bind-Value="@teacherobj.LinkedInLink" />
                            <ValidationMessage For="()=>teacherobj.LinkedInLink" />
                        </div>
                  
                    
                  
              <div class="form-group">

        <label class="control-label">Designation</label>

        <InputText class="form-control"
                     @bind-Value="teacherobj.Designation"  placeholder="e.g. Vice Principal">  </InputText>
        <ValidationMessage For="()=>teacherobj.Designation" />

</div>
                     
                        <div class="form-group">
                            <label class="control-label">Date of Birth</label>
                            <InputDate for="DOB" class="form-control" @bind-Value="@teacherobj.DOB" />
                            <ValidationMessage For="()=>teacherobj.DOB" />
                        </div>
						<div class="form-group">

        <label class="control-label">Gender</label>

       <InputSelect class="form-select" required @bind-Value="teacherobj.Gender">

								<option value="">Select Gender</option>
								<option value="@Gender.Male">Male</option>
								<option value="@Gender.Female">Female</option>
								<option value="@Gender.NonBinary">Non-binary</option>
							
							</InputSelect>

        <ValidationMessage For="()=>teacherobj.Gender" />

    </div>

                    
    <div class="form-group">

        <label class="control-label">Marital Status</label>

        <InputSelect class="form-select" required @bind-Value="teacherobj.MaritalStatus">

    <option value="">Select Marital Status</option>

    @foreach (var item in Enum.GetValues<MaritalStatus>())
    {
        <option value="@item">@item</option>
    }

</InputSelect>

        <ValidationMessage For="()=>teacherobj.MaritalStatus" />

    </div>

                   

                    </div>
                    
                     <div class="student-form-actions">
                    <button type="submit" class="student-btn-save"><i class="fas fa-save"></i>Save Teacher</button>
                      <a href="/teachers-list" class="student-btn-back"><i class="fas fa-arrow-left"></i>Back to List</a>              
                </div>

                     </EditForm>
    </div>
     </div>

@code {

    [SupplyParameterFromForm]
    public Teacher teacherobj { get; set; } = new();
	private bool ShowOtherDesignation =>
    teacherobj.Designation == "Others";
    // List<SystemCodeDetail> Designations = new List<SystemCodeDetail>(); 
    // List<SystemCodeDetail> Gender = new List<SystemCodeDetail>();
    //  List<SystemCodeDetail> MaritalStatus = new List<SystemCodeDetail>();
   
    protected override async Task OnInitializedAsync()
    {
        // Designations = await SystemCodeDetailsService.GetByCodeAsync("Designation");
        // Gender = await SystemCodeDetailsService.GetByCodeAsync("Gender");
        // MaritalStatus= await SystemCodeDetailsService.GetByCodeAsync("Marital Status");
		teacherobj.DOB = DateTime.Today;
    }
    
    protected async Task CreateTeacher()
    {
        var result = await TeacherService.AddTeacherAsync(teacherobj);
        navigation.NavigateTo("/teachers-list");
    }
    public void Cancel()
    {
        navigation.NavigateTo("/teachers-list");
    }
}

  