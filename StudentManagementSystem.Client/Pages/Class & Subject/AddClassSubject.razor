@page "/class-subjects"

@using Microsoft.AspNetCore.Authorization
@using StudentManagementSystemShared.Models
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin,Super Admin")]

@inject IClassSubjectRepository ClassSubjectRepository
@inject ISchoolClassRepository ClassRepository
@inject ISubjectRepository SubjectRepository
@inject ITeacherRepository TeacherRepository

<PageTitle>Class Subjects</PageTitle>

<div class="content-wrapper">

	<section class="content-header">
		<div class="container-fluid">
			<h1 class="page-title">
				<i class="fas fa-link"></i> Class Subject Assignment
			</h1>
		</div>
	</section>

	<section class="content">
		<div class="container-fluid">

			<!-- CLASS SELECT -->
			<div class="class-form-card">
				<div class="class-form-body">

					<div class="class-form-group">
						<label>Select Class</label>
						<InputSelect class="form-control"
									 @bind-Value="selectedClassId"
									 @bind-Value:after="OnClassChanged">

							<option value="">Select Class</option>

							@foreach (var c in classes)
							{
								<option value="@c.Id">@c.Name</option>
							}

						</InputSelect>

					</div>

				</div>
			</div>
			@if (!string.IsNullOrEmpty(successMessage))
			{
				<div class="alert alert-success">
					@successMessage
				</div>
			}
			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="alert alert-danger">
					@errorMessage
				</div>
			}
			@if (rows.Any())
			{
				<!-- ASSIGNMENT TABLE -->
				<div class="class-list-card">

					<div class="class-list-header">
						<h3 class="card-title">
							Assign Subjects to Teachers
						</h3>
					</div>

					<div class="card-body table-responsive">

						<table class="table table-bordered table-hover">

							<thead>
								<tr>
									<th>Subject</th>
									<th>Teacher</th>
								</tr>
							</thead>

							<tbody>
								@foreach (var row in rows)
								{
									<tr>

										<!-- SELECT SUBJECT -->
										<td>
											<input type="checkbox"
												   @bind="row.IsSelected" />
											<span class="ms-2">@row.SubjectName</span>
										</td>

										<!-- ASSIGN TEACHER -->
										<td>
											<InputSelect class="form-control"
														 @bind-Value="row.TeacherId"
														 disabled="@(!row.IsSelected)">

												<option value="">Select Teacher</option>

												@foreach (var t in teachers)
												{
													<option value="@t.Id">@t.FullName</option>
												}

											</InputSelect>
										</td>

									</tr>
								}
							</tbody>

						</table>

					</div>

					<div class="class-form-footer">
						<button class="class-save-btn"
								@onclick="SaveAssignments">
							Save Assignments
						</button>
					</div>

				</div>
			}

		</div>
	</section>

</div>

@code {

	private Guid? selectedClassId;
	private string? successMessage;
	private string? errorMessage;
	private List<ClassSubjectRow> rows = new();
	private List<ClassSubject> list = new();
	private List<SchoolClass> classes = new();
	private List<Subject> subjects = new();
	private List<Teacher> teachers = new();

	protected override async Task OnInitializedAsync()
	{
		classes = await ClassRepository.GetAllAsync();
		subjects = await SubjectRepository.GetAllAsync();
		teachers = await TeacherRepository.GetAllAsync();
		list = await ClassSubjectRepository.GetAllAsync();
	}
	private async Task BuildRows()
	{
		if (selectedClassId == Guid.Empty)
		{
			rows = new();
			return;
		}

		var assigned = await ClassSubjectRepository
			.GetByClassIdAsync(selectedClassId);

		rows = subjects.Select(s =>
		{
			var existing = assigned.FirstOrDefault(x => x.SubjectId == s.Id);

			return new ClassSubjectRow
				{
					SubjectId = s.Id,
					SubjectName = s.Name,
					TeacherId = existing?.TeacherId,
					ClassSubjectId = existing?.Id,
					IsSelected = existing != null,
					
				};
		}).ToList();
	}
	private async Task OnClassChanged()
	{
		if (selectedClassId == null || selectedClassId == Guid.Empty)
		{
			rows = new();
			StateHasChanged();
			return;
		}
		await BuildRows();
	}
	private async Task SaveAssignments()
	{
		var invalidRows = rows
		.Where(r => r.IsSelected && r.TeacherId == null)
		.ToList();

		if (invalidRows.Any())
		{
			errorMessage = "Teacher is required for all selected subjects.";
			StateHasChanged();
			return;
		}
		foreach (var row in rows)
		{
			
			var existing = await ClassSubjectRepository
	.GetByClassAndSubjectAsync(selectedClassId, row.SubjectId);

			// ❌ UNCHECKED = DELETE
			if (!row.IsSelected)
			{
				if (existing != null)
					await ClassSubjectRepository.DeleteAsync(existing.Id);

				continue;
			}

		
			if (row.TeacherId == null)
				continue;

			
			if (existing != null)
			{
				existing.TeacherId = row.TeacherId;

				await ClassSubjectRepository.UpdateAsync(existing);
			}
			else
			{
				
				await ClassSubjectRepository.AddAsync(new ClassSubject
					{
						Id = Guid.NewGuid(),
						SchoolClassId = selectedClassId,
						SubjectId = row.SubjectId,
						TeacherId = row.TeacherId
					});
			}
		}

		successMessage = "Assignments saved successfully!";
		await BuildRows();

		StateHasChanged();

		await Task.Delay(3000);
		successMessage = null;
		StateHasChanged();
	}

	
}