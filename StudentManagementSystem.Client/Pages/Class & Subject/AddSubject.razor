@page "/subjects-list"

@using Microsoft.AspNetCore.Authorization
@using StudentManagementSystemShared.Models
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin,Super Admin")]

@inject ISubjectRepository SubjectRepository

<PageTitle>Subjects</PageTitle>

<div class="content-wrapper">

	<section class="content-header">
		<div class="container-fluid">

			<div class="page-header">
				<h3 class="page-title"> <i class="fas fa-book"></i>Subjects Management</h3>
			</div>
		</div>
	</section>

	<section class="content">
		<div class="container-fluid">

			<!-- FORM -->
			<div class="class-form-card">

				<div class="class-form-header">
					<h3 class="card-title">
						@(isEdit ? "Edit Subject" : "Create Subject")
					</h3>
				</div>

				<EditForm Model="model"
						  OnValidSubmit="SaveSubject"
						  FormName="subject-form">

					<DataAnnotationsValidator />

					<div class="class-form-body">

						<div class="class-form-group">
							<label>Subject Name</label>
							<InputText class="form-control" @bind-Value="model.Name" />
						</div>

						<div class="class-form-group">
							<label>Code</label>
							<InputText class="form-control" @bind-Value="model.Code" />
						</div>

						<div class="class-form-group">
							<label>
								<InputCheckbox @bind-Value="model.IsCore" />
								Is Core Subject
							</label>
						</div>

					</div>

					<div class="class-form-footer">

						<button type="submit" class="class-save-btn">
							@(isEdit ? "Update" : "Save")
						</button>

						@if (isEdit)
						{
							<button type="button"
									class="class-cancel-btn"
									@onclick="ResetForm">
								Cancel
							</button>
						}
					</div>

				</EditForm>

			</div>

			<!-- TABLE -->
			<div class="class-list-card">

				<div class="class-list-header">
					<h3 class="card-title">Subjects List</h3>
				</div>

				<div class="card-body table-responsive p-0">

					<table class="table table-hover text-nowrap">

						<thead>
							<tr>
								<th>Name</th>
								<th>Code</th>
								<th>Core</th>
								<th>Actions</th>
							</tr>
						</thead>

						<tbody>

							@if (subjects.Any())
							{
								@foreach (var item in subjects)
								{
									<tr>
										<td>@item.Name</td>
										<td>@item.Code</td>
										<td>@(item.IsCore ? "Yes" : "No")</td>

										<td>
											<button type="button"
													class="btn-table btn-edit"
													@onclick="() => EditSubject(item)">
												<i class="fas fa-edit"></i><span>Edit</span>
											</button>

											<button type="button"
													class="btn-table btn-delete"
													@onclick="() => DeleteSubject(item.Id)">
												<i class="fas fa-trash"></i><span>Delete</span>
											</button>
										</td>
									</tr>
								}
							}
							else
							{
								<tr>
									<td colspan="4" class="text-center">
										No records found
									</td>
								</tr>
							}

						</tbody>

					</table>

				</div>

			</div>

		</div>
	</section>

</div>

@code {

	private List<Subject> subjects = new();

	[SupplyParameterFromForm]
	private Subject model { get; set; } = new();

	private bool isEdit = false;

	protected override async Task OnInitializedAsync()
	{
		await LoadData();
	}

	private async Task LoadData()
	{
		subjects = await SubjectRepository.GetAllAsync();
	}

	private async Task SaveSubject()
	{
		if (isEdit)
			await SubjectRepository.UpdateAsync(model);
		else
			await SubjectRepository.AddAsync(model);

		await LoadData();
		ResetForm();
	}

	private void EditSubject(Subject item)
	{
		model = new Subject
			{
				Id = item.Id,
				Name = item.Name,
				Code = item.Code,
				IsCore = item.IsCore
			};

		isEdit = true;
	}

	private async Task DeleteSubject(Guid id)
	{
		await SubjectRepository.DeleteAsync(id);
		await LoadData();
	}

	private void ResetForm()
	{
		model = new Subject();
		isEdit = false;
	}
}