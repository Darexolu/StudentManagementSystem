@page "/weekly-timetable"
@using Microsoft.AspNetCore.Authorization
@using StudentManagementSystemShared.Models
@using StudentManagementSystemShared.StudentRepository
@using StudentManagementSystem.Utility

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Super Admin,Teacher,Student")]
@inject ITimeTableRepository TimeTableRepository
@inject ISchoolClassRepository ClassRepository

<h3>Class Weekly Timetable</h3>

<hr />

<!-- CLASS SELECTOR -->
<div class="row mb-3">

	<div class="col-md-4">
		<label>Select Class</label>

		<InputSelect class="form-control"
					 @bind-Value="selectedClassId"
					 @bind-Value:after="LoadClassTimetable">
			<option value="">Select Class</option>

			@foreach (var c in classes)
			{
				<option value="@c.Id">@c.Name</option>
			}

		</InputSelect>
	</div>
	<div class="col-md-4">

		<label>Timetable Type</label>

		<InputSelect class="form-control"
					 @bind-Value="selectedTimeTableType"
					 @bind-Value:after="LoadClassTimetable">

			@foreach (var type in Enum.GetValues<TimeTableType>())
			{
				<option value="@type">@type</option>
			}

		</InputSelect>

</div>
</div>

@if (isLoading)
{
	<div class="alert alert-info">
		Loading timetable...
	</div>
}
else if (selectedClassId == null)
{
	<div class="alert alert-info">
		Please select a class to view timetable.
	</div>
}
else if (!slots.Any())
{
	<div class="alert alert-warning">
		No timetable found for this class.
	</div>
}
else
{
	<!-- TIMETABLE GRID -->
	<table class="table table-bordered text-center">

		<thead class="table-dark">
			<tr>
				<th>Time</th>
				<th>Monday</th>
				<th>Tuesday</th>
				<th>Wednesday</th>
				<th>Thursday</th>
				<th>Friday</th>
			</tr>
		</thead>

		<tbody>

			@foreach (var period in periods)
			{
				<tr>

					<td>
						@{
							var firstItem = classTimetable
							.FirstOrDefault(x => x.PeriodNumber == period);
						}

						@if (firstItem?.StartTime != null && firstItem?.EndTime != null)
						{
							<div>
								@DateTime.Today.Add(firstItem.StartTime.Value).ToString("hh:mm tt")
								-
								@DateTime.Today.Add(firstItem.EndTime.Value).ToString("hh:mm tt")
							</div>
						}

						<small>Period: @period</small>
					</td>

					@foreach (var day in weekdays)
					{
						var item = GetPeriodItem(day, period);

						<td>
							@if (item != null)
							{
								<div>
									<b>@item.Subject?.Name</b><br />
									@item.Teacher?.FullName
								</div>
							}
							else
							{
								<span class="text-muted">Free Period</span>
							}
						</td>
					}

				</tr>

				@if (period == 2)
				{
					<tr class="table-warning">
						<td colspan="6">
							<strong>SHORT BREAK</strong>
						</td>
					</tr>
				}

				@if (period == 5)
				{
					<tr class="table-info">
						<td colspan="6">
							<strong>LONG BREAK</strong>
						</td>
					</tr>
				}
			}

		</tbody>

	</table>
}

@code {
	private bool isLoading = false;
	private Guid? _selectedClassId;
	private List<int> periods = Enumerable.Range(1, 8).ToList();

	private Guid? selectedClassId
	{
		get => _selectedClassId;
		set
		{
			_selectedClassId = value;

			if (value != null)
			{
				_ = LoadClassTimetable();
			}
		}
	}
	private TimeTableType selectedTimeTableType = TimeTableType.Class;

	private List<SchoolClass> classes = new();

	private List<ClassTimeTable> classTimetable = new();

	private List<(TimeSpan Start, TimeSpan End)> slots = new();

	private List<DayOfWeek> weekdays = new()
	{
		DayOfWeek.Monday,
		DayOfWeek.Tuesday,
		DayOfWeek.Wednesday,
		DayOfWeek.Thursday,
		DayOfWeek.Friday
	};

	protected override async Task OnInitializedAsync()
	{
		classes = await ClassRepository.GetAllAsync();
	}
	private ClassTimeTable? GetPeriodItem(DayOfWeek day, int period)
	{
		return classTimetable.FirstOrDefault(x =>
			x.Day == day &&
			x.PeriodNumber == period);
	}
	private async Task LoadClassTimetable()
	{
		if (selectedClassId == null)
			return;

		isLoading = true;
		slots.Clear();
		classTimetable.Clear();

		StateHasChanged();

		classTimetable = await TimeTableRepository
        .GetByClassIdAsync(
        selectedClassId.Value,
        selectedTimeTableType);

		BuildSlots();

		isLoading = false;

		StateHasChanged();
	}

	private void BuildSlots()
	{
		slots = classTimetable
			.Where(x => x.StartTime.HasValue && x.EndTime.HasValue)
			.Select(x => (Start: x.StartTime.Value, End: x.EndTime.Value))
			.Distinct()
			.OrderBy(x => x.Start)
			.ToList();
	}

	private ClassTimeTable? GetCell(DayOfWeek day, TimeSpan start, TimeSpan end)
	{
		return classTimetable.FirstOrDefault(x =>
			x.Day == day &&
			x.StartTime == start &&
			x.EndTime == end
		);
	}
}