@page "/add-timetable"

@using Microsoft.AspNetCore.Authorization
@using StudentManagementSystemShared.Models
@using StudentManagementSystemShared.StudentRepository
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Super Admin,Teacher")]

@inject ITimeTableRepository TimeTableRepository
@inject ISchoolClassRepository ClassRepository
@inject ISubjectRepository SubjectRepository
@inject ITeacherRepository TeacherRepository
@inject IJSRuntime JS

<h3>Create Timetable</h3>

<hr />

<EditForm Model="this" OnValidSubmit="SaveAll">

	<DataAnnotationsValidator />
	<ValidationSummary />

	@if (!string.IsNullOrEmpty(validationMessage))
	{
		<div class="alert alert-danger">
			@validationMessage
		</div>
	}
	@if (!string.IsNullOrEmpty(successMessage))
	{
		<div class="alert alert-success">
			@successMessage
		</div>
	}

	<!-- CLASS -->
	<div class="row mb-3">

		<div class="col-md-6">
			<label>Select Class</label>

			<InputSelect required class="form-control"
						 @bind-Value="selectedClassId">

				<option value="">Select Class</option>

				@foreach (var c in classes)
				{
					<option value="@c.Id">@c.Name</option>
				}

			</InputSelect>
		</div>

	</div>

	<hr />

	<!-- GRID -->
	<table class="table table-bordered text-center">

		<thead class="table-dark">
			<tr>
				<th>Day</th>
				<th>Period</th>
				<th>Subject</th>
				<th>Teacher</th>
				<th>Start</th>
				<th>End</th>
				<th>Room</th>
			</tr>
		</thead>

		<tbody>

			@foreach (var item in entries)
			{
				<tr id="row-@item.Day-@item.PeriodNumber">

					<td>@item.Day</td>

					<td>@item.PeriodNumber</td>

					<td>
						<InputSelect class="form-control"
									 @bind-Value="item.SubjectId">

							<option value="">Select</option>

							@foreach (var s in subjects)
							{
								<option value="@s.Id">@s.Name</option>
							}

						</InputSelect>
					</td>

					<td>
						<InputSelect class="form-control"
									 @bind-Value="item.TeacherId">

							<option value="">Select</option>

							@foreach (var t in teachers)
							{
								<option value="@t.Id">@t.FullName</option>
							}

						</InputSelect>
					</td>

					<td>
						<input type="time"
							   class="form-control"
							   value="@GetStartTime(item)"
							   @onchange="e => SetStartTime(item, e.Value?.ToString())" />
					</td>

					<td>
						<input type="time"
							   class="form-control"
							   value="@GetEndTime(item)"
							   @onchange="e => SetEndTime(item, e.Value?.ToString())" />
					</td>

					<td>
						<InputText class="form-control"
								   @bind-Value="item.Room" />
					</td>

				</tr>
			}

		</tbody>

	</table>

	<button class="btn btn-primary mt-3" type="submit">
		Save Weekly Timetable
	</button>

</EditForm>

<hr />

<h4>Timetable List</h4>

@if (list.Any())
{
	<table class="table table-bordered table-striped">

		<thead>
			<tr>
				<th>Class</th>
				<th>Subject</th>
				<th>Teacher</th>
				<th>Day</th>
				<th>Start</th>
				<th>End</th>
				<th>Room</th>
				<th>Action</th>
			</tr>
		</thead>

		<tbody>

			@foreach (var item in list)
			{
				<tr>

					<td>@item.SchoolClass?.Name</td>

					<td>@item.Subject?.Name</td>

					<td>@item.Teacher?.FullName</td>

					<td>@item.Day</td>

					<td>
						@(item.StartTime.HasValue
										? DateTime.Today.Add(item.StartTime.Value).ToString("hh:mm tt")
										: "")
					</td>

					<td>
						@(item.EndTime.HasValue
										? DateTime.Today.Add(item.EndTime.Value).ToString("hh:mm tt")
										: "")
					</td>

					<td>@item.Room</td>

					<td>

						<button type="button"
								class="btn btn-warning btn-sm"
								@onclick="() => Edit(item)">
							Edit
						</button>

						<button type="button"
								class="btn btn-danger btn-sm ms-2"
								@onclick="() => Delete(item.Id)">
							Delete
						</button>

					</td>

				</tr>
			}

		</tbody>

	</table>
}
else
{
	<div class="alert alert-info">
		No timetable records found.
	</div>
}

@code {
	private Guid selectedClassId;
	private string? validationMessage;
	private string? successMessage;
	private bool isEdit = false;

	private List<ClassTimeTable> entries = new();
	private List<ClassTimeTable> list = new();

	private List<SchoolClass> classes = new();
	private List<Subject> subjects = new();
	private List<Teacher> teachers = new();

	protected override async Task OnInitializedAsync()
	{
		await LoadDropdowns();
		await Load();

		GenerateRows();
	}

	private void GenerateRows()
	{
		entries.Clear();

		var days = new[]
		{
			DayOfWeek.Monday,
			DayOfWeek.Tuesday,
			DayOfWeek.Wednesday,
			DayOfWeek.Thursday,
			DayOfWeek.Friday
		};

		foreach (var day in days)
		{
			for (int i = 1; i <= 8; i++)
			{
				entries.Add(new ClassTimeTable
					{
						Day = day,
						PeriodNumber = i,
						StartTime = TimeSpan.Zero,
						EndTime = TimeSpan.Zero
					});
			}
		}
	}

	private async Task LoadDropdowns()
	{
		classes = await ClassRepository.GetAllAsync();
		subjects = await SubjectRepository.GetAllAsync();
		teachers = await TeacherRepository.GetAllAsync();
	}

	private async Task Load()
	{
		list = await TimeTableRepository.GetAllAsync();
	}

	private async Task SaveAll()
	{
		if (selectedClassId == Guid.Empty)
		{
			validationMessage = "Please select a class.";
			return;
		}

		foreach (var item in entries)
		{
			if (item.SubjectId == null || item.TeacherId == null)
				continue;
			if (isEdit)
			{
				var existing = await TimeTableRepository
		.FindByClassDayPeriod(selectedClassId, item.Day, item.PeriodNumber);

				if (existing != null)
				{
					existing.SubjectId = item.SubjectId;
					existing.TeacherId = item.TeacherId;
					existing.StartTime = item.StartTime;
					existing.EndTime = item.EndTime;
					existing.Room = item.Room;
					selectedClassId = item.SchoolClassId;
					await TimeTableRepository.UpdateAsync(existing);
				}
			}
			else
			{
				await TimeTableRepository.AddAsync(new ClassTimeTable
					{
						SchoolClassId = selectedClassId,
						Day = item.Day,
						PeriodNumber = item.PeriodNumber,
						SubjectId = item.SubjectId,
						TeacherId = item.TeacherId,
						StartTime = item.StartTime,
						EndTime = item.EndTime,
						Room = item.Room
					});
			}
		}

		validationMessage = null;
		successMessage = null;
		isEdit = false;
		await Load();

		GenerateRows(); // reset grid
		successMessage = "Timetable saved successfully!";
	}

	private async Task Edit(ClassTimeTable item)
	{
		selectedClassId = item.SchoolClassId;
		var existing = entries.FirstOrDefault(x =>
			x.Day == item.Day &&
			x.PeriodNumber == item.PeriodNumber);

		if (existing != null)
		{
			existing.SubjectId = item.SubjectId;
			existing.TeacherId = item.TeacherId;
			existing.StartTime = item.StartTime;
			existing.EndTime = item.EndTime;
			existing.Room = item.Room;
			existing.SchoolClassId = item.SchoolClassId;

			var rowId = $"row-{item.Day}-{item.PeriodNumber}";

			await JS.InvokeVoidAsync("scrollToRow", rowId);
		}

		isEdit = true;
	}

	private async Task Delete(Guid id)
	{
		await TimeTableRepository.DeleteAsync(id);

		await Load();
	}

	// private void ClearForm()
	// {
	// 	model = new ClassTimeTable();

	// 	startTimeString = "";

	// 	endTimeString = "";

	// 	isEdit = false;
	// }

	private string GetStartTime(ClassTimeTable item)
	{
		return item.StartTime.HasValue
		? item.StartTime.Value.ToString(@"hh\:mm")
		: "";
	}

	private void SetStartTime(ClassTimeTable item, string value)
	{
		if (TimeSpan.TryParse(value, out var result))
		{
			item.StartTime = result;
		}
	}

	private string GetEndTime(ClassTimeTable item)
	{
		return item.EndTime.HasValue
				? item.EndTime.Value.ToString(@"hh\:mm")
				: "";
	}

	private void SetEndTime(ClassTimeTable item, string value)
	{
		if (TimeSpan.TryParse(value, out var result))
		{
			item.EndTime = result;
		}
	}
}