@page "/teacher-timetable"

@using Microsoft.AspNetCore.Authorization
@using StudentManagementSystemShared.Models
@using StudentManagementSystemShared.StudentRepository
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Super Admin,Teacher")]

@inject ITeacherRepository TeacherRepository
@inject ITimeTableRepository TimeTableRepository

<!-- Desktop/Laptop Only -->
<div class="d-none d-lg-block">

	<div class="class-list-header">
		<h3 class="page-title">
			<i class="fas fa-calendar-plus"></i> Teacher Timetable
		</h3>
	</div>

	<div class="row mb-4">

		<div class="class-form-group">

			<label>Select Teacher</label>

			<InputSelect class="form-control"
						 @bind-Value="selectedTeacherId">

				<option value="">Select Teacher</option>

				@foreach (var teacher in teachers)
				{
					<option value="@teacher.Id">
						@teacher.FullName
					</option>
				}

			</InputSelect>

		</div>

	</div>

	@if (isLoading)
	{
		<div class="alert alert-info">
			Loading timetable...
		</div>
	}
	else if (selectedTeacherId == null)
	{
		<div class="alert alert-info">
			Please select a teacher.
		</div>
	}
	else if (!slots.Any())
	{
		<div class="alert alert-warning">
			No timetable found for this teacher.
		</div>
	}
	else
	{
		<table class="table table-bordered text-center timetable-table">

			<thead class="table-dark">

				<tr>
					<th>Time</th>
					<th>Monday</th>
					<th>Tuesday</th>
					<th>Wednesday</th>
					<th>Thursday</th>
					<th>Friday</th>
				</tr>

			</thead>

			<tbody>

				@foreach (var slot in slots)
				{
					<tr>

						<td>
							@{
								var period = teacherTimetable.FirstOrDefault(x =>
								x.StartTime == slot.Start &&
								x.EndTime == slot.End)?.PeriodNumber;
							}

							<b>
								@DateTime.Today.Add(slot.Start).ToString("hh:mm tt")
								-
								@DateTime.Today.Add(slot.End).ToString("hh:mm tt")
							</b>

							<br />

							@if (period != null)
							{
								<small>
									Period: @period
								</small>
							}

						</td>

						@foreach (var day in weekdays)
						{
							<td>

								@{
									var item = GetCell(day, slot.Start, slot.End);
								}

								@if (item != null)
								{
									<div>
										<b>@item.Subject?.Name</b>
									</div>

									<div>
										@item.SchoolClass?.Name
									</div>
								}

							</td>
						}

					</tr>
				}

			</tbody>

		</table>
	}

</div>

<!-- Mobile & Tablet Message -->
<div class="d-block d-lg-none">

	<div class="alert alert-warning text-center mt-5">
		<i class="fas fa-desktop fa-3x mb-3"></i>

		<h4>Desktop Required</h4>

		<p class="mb-0">
			The Teacher Timetable page is available only on desktop or laptop devices.
			Please use a larger screen to view and manage the timetable.
		</p>
	</div>

</div>
@code {

	private Guid? _selectedTeacherId;

	private Guid? selectedTeacherId
	{
		get => _selectedTeacherId;
		set
		{
			_selectedTeacherId = value;

			if (value != null)
			{
				_ = LoadTeacherTimetable();
			}
		}
	}

	private bool isLoading = false;

	private List<Teacher> teachers = new();

	private List<ClassTimeTable> teacherTimetable = new();

	private List<(TimeSpan Start, TimeSpan End)> slots = new();

	private List<DayOfWeek> weekdays = new()
	{
		DayOfWeek.Monday,
		DayOfWeek.Tuesday,
		DayOfWeek.Wednesday,
		DayOfWeek.Thursday,
		DayOfWeek.Friday
	};

	protected override async Task OnInitializedAsync()
	{
		teachers = await TeacherRepository.GetAllAsync();
	}

	private async Task LoadTeacherTimetable()
	{
		if (selectedTeacherId == null || selectedTeacherId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("toast.warning", "Please select a class first.");
            return;
        }

		isLoading = true;

		teacherTimetable.Clear();

		slots.Clear();

		StateHasChanged();

		teacherTimetable = await TimeTableRepository
			.GetTeacherTimeTable(selectedTeacherId.Value);

		BuildSlots();
		  await JS.InvokeVoidAsync("toast.success", "Timetable loaded successfully.");
		isLoading = false;

		StateHasChanged();
	}

	private void BuildSlots()
	{
		slots = teacherTimetable
			.Where(x => x.StartTime.HasValue && x.EndTime.HasValue)
			.Select(x => (Start: x.StartTime.Value, End: x.EndTime.Value))
			.Distinct()
			.OrderBy(x => x.Start)
			.ToList();
	}

	private ClassTimeTable? GetCell(
		DayOfWeek day,
		TimeSpan start,
		TimeSpan end)
	{
		return teacherTimetable.FirstOrDefault(x =>
			x.Day == day &&
			x.StartTime == start &&
			x.EndTime == end
		);
	}
}