@page "/parents-list"
@using StudentManagementSystemShared.Models;
@inject NavigationManager navigation;
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Super Admin")]
@inject IJSRuntime JsRuntime



<div class="row">
     <div class="col-12">
          <div class="card">
           <div class="card-header">
				<div class="page-actions">
					<p><a class="btn-add" href="/add-parent"><i class="fas fa-plus"></i> Add New Parent</a></p>
               </div>
			</div>
               <div class="card-body">
    <div class="row">
       
					<h3 class="page-title"><i class="fas fa-people-group"></i>Parents</h3>
        <div class="col-md-12">
            <div class="card">
               @*  @if (!AllParents.Any())
                {
                    <p><em>Loading Parents...</em></p>
                } *@
                @if (AllParents.Any())
                {
                    <div class="card-body">
									<div class="table-responsive">
										<table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
													<!-- Mobile -->
													<th class="d-table-cell d-md-none">Parent</th>

													<!-- Desktop -->
													<th style="white-space: nowrap;" class="d-none d-md-table-cell">Full Name</th>
													<th class="d-none d-md-table-cell">Email</th>
													<th class="d-none d-md-table-cell">PhoneNo</th>
													<th class="d-none d-md-table-cell">Student</th>
													<th class="d-none d-md-table-cell">Gender</th>
													<th>Edit</th>
													<th>Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var parent in AllParents)
                                {
                                    <tr>
														<!-- Mobile -->
														<td class="d-table-cell d-md-none">
															<div class="student-mobile">
																<div class="student-name">@parent.FirstName @parent.LastName</div>
																<div class="student-admission">@parent.PhoneNumber</div>
															</div>
														</td>
														<!-- Desktop -->
														<td class="d-none d-md-table-cell">@parent.FullName</td>
														<td class="d-none d-md-table-cell">@parent.EmailAddress</td>
												<td class="d-none d-md-table-cell">@parent.PhoneNumber</td>
														<td class="d-none d-md-table-cell">@parent.Student.FullName</td>
														<td style="white-space: nowrap;" class="d-none d-md-table-cell">
										    @parent.Gender?.ToString().Replace("NonBinary", "Non-binary")
										</td>

                                        <td>
															<a class="btn-table btn-edit" href="/parent/edit/@parent.Id"><i class="fas fa-edit"></i><span>Edit</span> </a>
                                        </td>
                                        <td>
															<a class="btn-table btn-delete" href="/parent/delete/@parent.Id"> <i class="fas fa-trash"></i><span>Delete</span> </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
									</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info"> There is no Parent Available</div>
                }
            </div>

        </div>
    </div>
</div>
</div>
    </div>
</div>

@code {
    private List<Parent> AllParents { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadAllParents();
    }
    private async Task LoadAllParents()
    {
        var parents = await ParentService.GetAllAsync();
        AllParents.Clear();
        if (parents is null) return;
        foreach (var parent in parents)
        {
            AllParents.Add(parent);
        }
    }
    private void EditParent(int id)
    {
        navigation.NavigateTo($"/parent/edit/{id}");
    }
    private async Task DeleteParent(Guid Id)
    {
        var result = await ParentService.DeleteAsync(Id);
        await LoadAllParents();
    }

}