@page "/parent/edit/{id:guid}"
@using StudentManagementSystemShared.Models;
@inject NavigationManager navigation;
@using Microsoft.AspNetCore.Authorization;
@using StudentManagementSystem.Utility;
@attribute [Authorize(Roles = "Admin,Super Admin")]


<div class="student-form-header">

	<h2 class="student-form-title"><i class="fas fa-user-edit"></i>Update Parent</h2>
	<p class="student-form-subtitle">
		Update parent's details below.
	</p>
</div>

@* <hr /> *@
<div class="student-form-wrapper">
<div class="student-form-card">
 <EditForm Model="parentobj" OnValidSubmit="UpdateParent" FormName="updateparent">

			<div class="student-form-grid">
				<div class="form-group">
					<label class="control-label">First Name</label>
					<InputText required for="FirstName" class="form-control" @bind-Value="@parentobj.FirstName" />
					<ValidationMessage For="()=>parentobj.FirstName" />
				</div>

				<div class="form-group">
					<label class="control-label">Middle Name</label>
					<InputText required for="MiddleName" class="form-control" @bind-Value="@parentobj.MiddleName" />
					<ValidationMessage For="()=>parentobj.MiddleName" />
				</div>


				<div class="form-group">
					<label class="control-label">Last Name</label>
					<InputText required for="LastName" class="form-control" @bind-Value="@parentobj.LastName" />
					<ValidationMessage For="()=>parentobj.LastName" />
				</div>


				<div class="form-group">
					<label class="control-label">Email Address</label>
					<InputText for="EmailAddress" class="form-control" @bind-Value="@parentobj.EmailAddress" />
					<ValidationMessage For="()=>parentobj.EmailAddress" />
				</div>


				<div class="form-group">
					<label class="control-label">Parent Address</label>
					<InputTextArea for="Address" class="form-control" style="resize: none;" @bind-Value="@parentobj.Address" />
					<ValidationMessage For="()=>parentobj.Address" />
				</div>


				<div class="form-group">
					<label class="control-label">Phone Number</label>
					<InputText required for="PhoneNumber" class="form-control" @bind-Value="@parentobj.PhoneNumber" />
					<ValidationMessage For="()=>parentobj.PhoneNumber" />
				</div>
				<div class="form-group">
					<label class="control-label">Date of Birth</label>
					<InputDate for="DOB" class="form-control" @bind-Value="@parentobj.DOB" />
					<ValidationMessage For="()=>parentobj.DOB" />
				</div>
				<div class="form-group">
					<label class="control-label">Relationship with student</label>
					<InputText required for="Relationship" class="form-control" @bind-Value="@parentobj.Relationship">

					</InputText>

					<ValidationMessage For="()=>parentobj.Relationship" />
				</div>

				<div class="form-group">

					<label class="control-label">Gender</label>

					<InputSelect required class="form-select" @bind-Value="parentobj.Gender">

						<option value="">Select Gender</option>
						<option value="@Gender.Male">Male</option>
						<option value="@Gender.Female">Female</option>
						<option value="@Gender.NonBinary">Non-binary</option>

					</InputSelect>

					<ValidationMessage For="()=>parentobj.Gender" />

				</div>


				<div class="form-group">

					<label class="control-label">Marital Status</label>

					<InputSelect required class="form-select" @bind-Value="parentobj.MaritalStatus">

						<option value="">Select Marital Status</option>

						@foreach (var item in Enum.GetValues<MaritalStatus>())
						{
							<option value="@item">@item</option>
						}

					</InputSelect>

					<ValidationMessage For="()=>parentobj.MaritalStatus" />

				</div>

				<div class="form-group">
					<label class="control-label">Student</label>
					<InputSelect required for="StudentId" class="form-select" @bind-Value="@parentobj.StudentId">
						<option value="">Select Student</option>

						@foreach (var student in Students)
						{
							<option value="@student.Id">@student.FullName</option>
						}
					</InputSelect>

					<ValidationMessage For="()=>parentobj.StudentId" />
				</div>
			</div>
			<div class="student-form-actions">
				<button type="submit" class="student-btn-save">Update Parent</button>
				<a href="/parents-list" class="student-btn-back">Back to List</a>
			</div>

                     </EditForm>
    </div>
     </div>

@code {

    [SupplyParameterFromForm]
    public Parent parentobj { get; set; } = new();

    [Parameter]
    public Guid id { get; set; }

    // List<SystemCodeDetail> ParentType = new List<SystemCodeDetail>(); 
    
    List<Student> Students = new List<Student>();

    protected override async Task OnInitializedAsync()
    {
       
            await LoadParent();

    }
    public async Task LoadParent()
	{
		if (id != Guid.Empty && parentobj.FirstName == null)
		{
			parentobj = await ParentService.GetByIdAsync(id);
		}
		else
		{
			parentobj.Id = id;
		}  
        // ParentType = await SystemCodeDetailsService.GetByCodeAsync("Parent Type");
        Students = await StudentService.GetAllStudentsAsync();

    }
    protected async Task UpdateParent()
	{
		try
		{
			await ParentService.UpdateAsync(parentobj);

			await JS.InvokeVoidAsync("toast.success", "Parent updated successfully.");

			navigation.NavigateTo("/parents-list");
		}
		catch (Exception)
		{
			await JS.InvokeVoidAsync("toast.error", "An error occurred while updating the parent.");
		}
    }
    public void Cancel()
    {
        navigation.NavigateTo("/parents-list");
    }
}