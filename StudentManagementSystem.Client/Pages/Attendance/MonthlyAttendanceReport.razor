@page "/monthly-attendance"

@using StudentManagementSystemShared.Models
@using StudentManagementSystemShared.ViewModels

@inject ISchoolClassRepository SchoolClassRepository
@inject IAttendanceRepository AttendanceRepository
@rendermode InteractiveServer

<div class="class-list-header">
	<h3 class="page-title"><i class="fas fa-calendar-check"></i> Monthly Attendance Report</h3>
</div>
<EditForm Model="@this" OnValidSubmit="LoadReport">
	<DataAnnotationsValidator />

	<div class="row mb-3">

		<div class="class-form-group">
			<label>Class</label>

			<InputSelect required class="form-control"
						 @bind-Value="selectedClassId">

				<option value="">Select Class</option>

				@foreach (var item in classes)
				{
					<option value="@item.Id">@item.Name</option>
				}

			</InputSelect>

		</div>

		<div class="class-form-group">
			<label>Month</label>

			<InputNumber class="form-control"
						 @bind-Value="month" />
		</div>

		<div class="class-form-group">
			<label>Year</label>

			<InputNumber class="form-control"
						 @bind-Value="year" />
		</div>

		<div class="col-md-2 mt-4">
			<button type="submit" class="btn btn-primary">
				Load Report
			</button>
		</div>

	</div>
</EditForm>
@if (!string.IsNullOrEmpty(successMessage))
{
	<div class="alert alert-success">
		@successMessage
	</div>
}
@if (records.Any())
{
	<table class="table table-bordered table-striped" style="margin-top: 20px;">

		<thead>
			<tr>
				<th>Student</th>
				<th>Present</th>
				<th>Absent</th>
				<th>Total Days</th>
				<th>
					<span class="d-none d-md-inline">Attendance %</span>
					<span class="d-inline d-md-none">%</span>
				</th>
			</tr>
		</thead>

		<tbody>

			@foreach (var item in records)
			{
				<tr>

					<td>
						<span class="d-none d-md-inline">
							@item.StudentName
						</span>

						<span class="d-inline d-md-none">
							@(string.Join(" ", item.StudentName.Split(' ').Take(2)))
						</span>
					</td>

					<td>@item.PresentDays</td>

					<td>@item.AbsentDays</td>

					<td>@item.TotalDays</td>

					<td>
						@item.AttendancePercentage.ToString("0.00")%
					</td>

				</tr>
			}

		</tbody>

	</table>
}

@code {

		private Guid selectedClassId;

		private int month = DateTime.Today.Month;

		private int year = DateTime.Today.Year;
	private string? successMessage;

		private List<SchoolClass> classes = new();

		private List<AttendanceSummaryViewModel> records = new();

		protected override async Task OnInitializedAsync()
		{
			classes = await SchoolClassRepository.GetAllAsync();
		}

		private async Task LoadReport()
		{
			records = await AttendanceRepository
				.GetMonthlySummaryAsync(
					selectedClassId,
					year,
					month);
		successMessage = "Monthly attendance report loaded successfully.";
		}
	
}