@page "/settings"

@using Microsoft.AspNetCore.Authorization
@using StudentManagementSystem.Client.Services
@using StudentManagementSystemShared.Models
@using StudentManagementSystem.Utility;
@inject AppSettingsService AppSettings

@rendermode InteractiveServer
@attribute [Authorize(Roles = "Super Admin,Admin")]

@inject ISystemSettingsRepository SettingsRepository

<PageTitle>School Settings</PageTitle>

<div class="content-wrapper">

	<section class="content-header">
		<div class="container-fluid">
			<h3 class="page-title"><i class="fas fa-cogs"></i> School Settings</h3>
		</div>
	</section>

	<section class="content">
		<div class="container-fluid">

			@if (!string.IsNullOrEmpty(successMessage))
			{
				<div class="alert alert-success">
					@successMessage
				</div>
			}

			<div class="card card-primary">

				<div class="card-header">
					<h5 class="card-title">School Information</h5>
				</div>

				<EditForm Model="model" OnValidSubmit="SaveSettings" FormName="systemsettings">

					<DataAnnotationsValidator />

					<div class="card-body">

						<div class="row">

							<div class="col-md-6">
								<label>School Name</label>
								<InputText class="form-control"
										   @bind-Value="model.SchoolName" />
							</div>

							<div class="col-md-6">
								<label>Motto</label>
								<InputText class="form-control"
										   @bind-Value="model.SchoolMotto" />
							</div>

							<div class="col-md-12">
								<label>Address</label>
								<InputTextArea class="form-control"
										   @bind-Value="model.SchoolAddress" />
							</div>

							<div class="col-md-6">
								<label>Phone</label>
								<InputText class="form-control"
										   @bind-Value="model.SchoolPhone" />
							</div>

							<div class="col-md-6">
								<label>Email</label>
								<InputText class="form-control"
										   @bind-Value="model.SchoolEmail" />
							</div>

							<div class="col-md-6">
								<label>Principal</label>
								<InputText class="form-control"
										   @bind-Value="model.PrincipalName" />
							</div>

							<div class="col-md-6">
								<label>Current Term</label>
								<InputSelect class="form-control"
											 @bind-Value="model.CurrentTerm">

									@foreach (var term in Enum.GetValues<SchoolTerm>())
									{
										<option value="@term">@term.ToString().Replace("Term", " Term")</option>
									}

								</InputSelect>
							</div>

							<div class="col-md-6">
								<label>Session</label>
								<InputText class="form-control"
										   @bind-Value="model.CurrentSession" />
							</div>

							<div class="col-md-12">
								<label>Logo URL</label>
								<InputText class="form-control"
										   @bind-Value="model.LogoUrl" />
							</div>

						</div>

					</div>

					<div class="card-footer">
						<button class="btn btn-primary" type="submit">
							Save Settings
						</button>
					</div>

				</EditForm>

			</div>

		</div>
	</section>

</div>

@code {

	private SystemSetting model = new();
	private string successMessage;

	protected override async Task OnInitializedAsync()
	{
		model = await SettingsRepository.GetAsync()
			?? new SystemSetting();
	}

	private async Task SaveSettings()
	{
		await SettingsRepository.SaveAsync(model);
		AppSettings.Update(model);
		successMessage = "Settings saved successfully.";
	}
}