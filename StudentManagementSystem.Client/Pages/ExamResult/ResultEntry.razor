@page "/result-entry"

@using StudentManagementSystem.Client.Pages.Search
@using StudentManagementSystemShared.Models
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin,Super Admin,Teacher")]

@inject IResultRepository ResultRepository
@inject IStudentRepository StudentRepository
@inject ISchoolClassRepository ClassRepository
@inject ISubjectRepository SubjectRepository

<PageTitle>Results Management</PageTitle>

<div class="content-wrapper">

	<section class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<div class="page-header">
						<h1 class="page-title"> <i class="fas fa-file-alt"></i>Examination & Results</h1>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="content">

		<div class="container-fluid">

			

				<EditForm Model="model"  FormName="resultentry">

					<DataAnnotationsValidator />

					<div class="class-form-card">

						<div class="class-form-header">
							<h3 class="card-title">
								Bulk Result Entry
							</h3>
						</div>

						<div class="class-form-body">

							<div class="row">

								<div class="col-md-3">
									<label>Class</label>

									<InputSelect required class="form-control"
												 @bind-Value="selectedClassId">

										<option value="">Select Class</option>

										@foreach (var item in classes)
										{
											<option value="@item.Id">
												@item.Name
											</option>
										}

									</InputSelect>
								</div>

								<div class="col-md-3">
									<label>Subject</label>

									<SearchableSelect TItem="Subject"
                  Items="subjects"
                  TextField="x => x.Name"
                  ValueField="x => x.Id"
                  @bind-Value="selectedSubjectId" />
								</div>

								<div class="col-md-3">
									<label>Term</label>

									<InputSelect class="form-control"
												 @bind-Value="selectedTerm">

										<option value="First Term">First Term</option>
										<option value="Second Term">Second Term</option>
										<option value="Third Term">Third Term</option>

									</InputSelect>
								</div>

								<div class="col-md-3">
									<label>Session</label>

									<InputText class="form-control"
											   @bind-Value="selectedSession" />
								</div>

							</div>

							<div class="mt-3">

								<button class="class-save-btn"
										@onclick="LoadStudentsForEntry">

									Load Students

								</button>

							</div>

						</div>

					</div>

				</EditForm>

		

			<div class="class-list-card">

				

				@if (resultEntries.Any())
				{
					<div class="class-list-card mt-4">

						<div class="class-list-header">
							<h3>Student Result Entry</h3>
						</div>

						<div class="table-responsive">

							<table class="table table-bordered">

								<thead>

									<tr>
										<th>Student</th>
										<th>Test 1</th>
										<th>Test 2</th>
										<th>Assignment</th>
										<th>Exam</th>
										<th>Total</th>
										<th>Grade</th>
									</tr>

								</thead>

								<tbody>

									@foreach (var item in resultEntries)
									{
										<tr>

											<td>@item.StudentName</td>

											<td>
												<InputNumber class="form-control"
															 @bind-Value="item.Test1" />
											</td>

											<td>
												<InputNumber class="form-control"
															 @bind-Value="item.Test2" />
											</td>

											<td>
												<InputNumber class="form-control"
															 @bind-Value="item.Assignment" />
											</td>

											<td>
												<InputNumber class="form-control"
															 @bind-Value="item.Exam" />
											</td>

											<td>
												@(item.Test1 +
																						item.Test2 +
																						item.Assignment +
																						item.Exam)
											</td>

											<td>
												@GetGrade(
																								item.Test1 +
																								item.Test2 +
																								item.Assignment +
																								item.Exam)
											</td>

										</tr>
									}

								</tbody>

							</table>

						</div>

						<div class="p-3">

							<button class="class-save-btn"
									@onclick="SaveAllResults">

								Save All Results

							</button>

						</div>

					</div>
				}

			</div>

		</div>

	</section>

</div>

@code {
	[SupplyParameterFromForm]
	private Result model { get; set; } = new();

	private bool isEdit = false;

	private List<Result> results = new();
	private List<Student> students = new();
	private List<SchoolClass> classes = new();
	private List<Subject> subjects = new();

	protected override async Task OnInitializedAsync()
	{
		students = await StudentRepository.GetAllStudentsAsync();
		classes = await ClassRepository.GetAllAsync();
		subjects = await SubjectRepository.GetAllAsync();

		await Load();
	}

	private async Task Load()
	{
		results = await ResultRepository.GetAllAsync();
	}

	private async Task SaveResult()
	{
		model.Total = GetTotal();
		model.Grade = GetGrade();

		if (isEdit)
		{
			await ResultRepository.UpdateAsync(model);
		}
		else
		{
			await ResultRepository.AddAsync(model);
		}

		await Load();

		ResetForm();
	}

	private void EditResult(Result item)
	{
		model = new Result
			{
				Id = item.Id,
				StudentId = item.StudentId,
				SubjectId = item.SubjectId,
				SchoolClassId = item.SchoolClassId,
				Test1 = item.Test1,
				Test2 = item.Test2,
				Assignment = item.Assignment,
				Exam = item.Exam,
				TeacherRemark = item.TeacherRemark,
				PrincipalComment = item.PrincipalComment
			};

		isEdit = true;
	}

	private async Task DeleteResult(Guid id)
	{
		await ResultRepository.DeleteAsync(id);

		await Load();
	}

	private decimal GetTotal()
	{
		return model.Test1 +
						model.Test2 +
						model.Assignment +
						model.Exam;
	}

	private string GetGrade()
	{
		var total = GetTotal();

		if (total >= 70)
			return "A";

		if (total >= 60)
			return "B";

		if (total >= 50)
			return "C";

		if (total >= 45)
			return "D";

		if (total >= 40)
			return "E";

		return "";
	}

	private void ResetForm()
	{
		model = new Result();

		isEdit = false;
	}


	/// <summary>
	///New
	/// </summary>
	private Guid selectedClassId;

	private Guid selectedSubjectId;

	private string selectedTerm = "First Term";

	private string selectedSession =
		$"{DateTime.Now.Year}/{DateTime.Now.Year + 1}";

	private List<BulkResultEntry> resultEntries = new();

	private async Task LoadStudentsForEntry()
	{
		var classStudents =
			await StudentRepository.GetByClassIdAsync(selectedClassId);

		var existingResults =
			await ResultRepository.GetByClassSubjectTermSessionAsync(
				selectedClassId,
				selectedSubjectId,
				selectedTerm,
				selectedSession);

		resultEntries = classStudents
			.Select(student =>
			{
				var existing = existingResults
					.FirstOrDefault(x => x.StudentId == student.Id);

				return new BulkResultEntry
					{
						StudentId = student.Id,
						StudentName = student.FullName,

						Test1 = existing?.Test1 ?? 0,
						Test2 = existing?.Test2 ?? 0,
						Assignment = existing?.Assignment ?? 0,
						Exam = existing?.Exam ?? 0
					};
			})
			.ToList();
	}
	private async Task SaveAllResults()
	{
		foreach (var item in resultEntries)
		{
			var total =
				item.Test1 +
				item.Test2 +
				item.Assignment +
				item.Exam;

			var existing = await ResultRepository.GetStudentResultAsync(
				item.StudentId,
				selectedClassId,
				selectedSubjectId,
				selectedTerm,
				selectedSession);

			if (existing == null)
			{
				var result = new Result
					{
						StudentId = item.StudentId,
						SchoolClassId = selectedClassId,
						SubjectId = selectedSubjectId,
						Test1 = item.Test1,
						Test2 = item.Test2,
						Assignment = item.Assignment,
						Exam = item.Exam,
						Total = total,
						Grade = GetGrade(total),
						Term = selectedTerm,
						Session = selectedSession
					};

				await ResultRepository.AddAsync(result);
			}
			else
			{
				existing.Test1 = item.Test1;
				existing.Test2 = item.Test2;
				existing.Assignment = item.Assignment;
				existing.Exam = item.Exam;
				existing.Total = total;
				existing.Grade = GetGrade(total);

				await ResultRepository.UpdateAsync(existing);
			}
		}

		await Load();
	}

	private string GetGrade(decimal total)
	{
		if (total >= 70) return "A";
		if (total >= 60) return "B";
		if (total >= 50) return "C";
		if (total >= 45) return "D";
		if (total >= 40) return "E";

		return "F";
	}
}
