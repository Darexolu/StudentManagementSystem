@page "/student-result-sheet"

@using StudentManagementSystemShared.Models
@inject IStudentRepository StudentRepository
@inject IResultRepository ResultRepository
@rendermode InteractiveServer
@inject ReportCardPdfService PdfService
@inject IJSRuntime JS

<h3 class="page-title">Student Result Sheet</h3>

<div class="row mb-3">

	<div class="col-md-4">
		<label>Select Student</label>

		<InputSelect class="form-control"
					 @bind-Value="selectedStudentId"
					 @bind-Value:after="LoadResults">

			<option value="@Guid.Empty">Select Student</option>

			@foreach (var s in students)
			{
				<option value="@s.Id">@s.FullName</option>
			}

		</InputSelect>
	</div>

	<div class="col-md-3">
		<label>Term</label>

		<InputSelect class="form-control"
					 @bind-Value="term"
					 @bind-Value:after="LoadResults">

			<option>First Term</option>
			<option>Second Term</option>
			<option>Third Term</option>

		</InputSelect>
	</div>

	<div class="col-md-3">
		<label>Session</label>

		<InputText class="form-control"
				   @bind-Value="session"
				   @bind-Value:after="LoadResults" />
	</div>

</div>

@if (results.Any())
{
	<!-- Desktop Table -->
	<div class="d-none d-md-block">

		<div class="table-responsive">
			<table class="table table-bordered">

				<thead class="table-dark">
					<tr>
						<th>Subject</th>
						<th>Test1</th>
						<th>Test2</th>
						<th>Assignment</th>
						<th>Exam</th>
						<th>Total</th>
						<th>Grade</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var r in results)
					{
						<tr>
							<td>@r.Subject?.Name</td>
							<td>@r.Test1</td>
							<td>@r.Test2</td>
							<td>@r.Assignment</td>
							<td>@r.Exam</td>
							<td>@r.Total</td>
							<td>@r.Grade</td>
						</tr>
					}
				</tbody>

			</table>
		</div>

	</div>

	<!-- Mobile Cards -->
	<div class="d-block d-md-none">

		@foreach (var r in results)
		{
			<div class="card mb-3 shadow-sm">

				<div class="card-header fw-bold">
					@r.Subject?.Name
				</div>

				<div class="card-body">

					<div class="d-flex justify-content-between mb-2">
						<span>Test 1</span>
						<strong>@r.Test1</strong>
					</div>

					<div class="d-flex justify-content-between mb-2">
						<span>Test 2</span>
						<strong>@r.Test2</strong>
					</div>

					<div class="d-flex justify-content-between mb-2">
						<span>Assignment</span>
						<strong>@r.Assignment</strong>
					</div>

					<div class="d-flex justify-content-between mb-2">
						<span>Exam</span>
						<strong>@r.Exam</strong>
					</div>

					<hr />

					<div class="d-flex justify-content-between mb-2">
						<span>Total</span>
						<strong>@r.Total</strong>
					</div>

					<div class="d-flex justify-content-between">
						<span>Grade</span>
						<span class="badge bg-primary px-3 py-2">
							@r.Grade
						</span>
					</div>

				</div>

			</div>
		}

	</div>

	<button class="btn btn-primary mt-3" @onclick="DownloadPdf">
		Print Result Sheet (PDF)
	</button>
}

@code {

	private Guid selectedStudentId;
	private string term = "First Term";
	private string session = $"{DateTime.Now.Year}/{DateTime.Now.Year + 1}";

	private List<Student> students = new();
	private List<Result> results = new();

	protected override async Task OnInitializedAsync()
	{
		students = await StudentRepository.GetAllStudentsAsync();
	}

	private async Task LoadResults()
	{
		try
		{
			if (selectedStudentId == Guid.Empty)
			{
				results.Clear();
				StateHasChanged();
				await JS.InvokeVoidAsync("toast.warning", "Please select a student first.");
				return;
			}

			results = await ResultRepository.GetStudentResultSheetAsync(
				selectedStudentId,
				term,
				session);

			await JS.InvokeVoidAsync("toast.success", "Student results loaded successfully.");
		}
		catch (Exception)
		{
			await JS.InvokeVoidAsync("toast.error", "An error occurred while loading the student's results.");
		}
	}
	

	private async Task DownloadPdf()
	{
		var data = await ResultRepository.GetStudentReportCardAsync(
			selectedStudentId,
			term,
			session);

		if (data == null)
			return;

		var bytes = PdfService.Generate(
	data,
	AppSettings.Settings?.SchoolName,
	AppSettings.Settings?.SchoolAddress);

		await JS.InvokeVoidAsync(
	"downloadFile",
	"ReportCard.pdf",
	bytes);
	}
}